SECRET_KEY=django-insecure-threadloom-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

USE_POSTGRES=True
# Local Postgres example:
# DATABASE_URL=postgres://postgres:your-password-here@localhost:5432/threadloom
# Neon (production) — use the *pooled* connection string (host has
# "-pooler" in it) and keep ?sslmode=require:
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/threadloom?sslmode=require

USE_S3=False
# Cloudflare R2 (production) — bucket must be created in the R2 dashboard
# first; these come from an R2 API token, not an AWS account.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# Leave AWS_S3_ENDPOINT_URL unset instead to use real AWS S3
# (AWS_S3_REGION_NAME then defaults to us-east-1).

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=True

CORS_ALLOW_ALL=True
