SECRET_KEY=django-insecure-threadloom-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

USE_POSTGRES=True
# Local Postgres example:
# DATABASE_URL=postgres://postgres:your-password-here@localhost:5432/threadloom
# Neon (production) — use the *pooled* connection string (host has
# "-pooler" in it) and keep ?sslmode=require:
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/threadloom?sslmode=require

USE_S3=False
# Backblaze B2 (production) — bucket + Application Key created in the B2
# dashboard first; these come from that key, not an AWS account.
# AWS_ACCESS_KEY_ID=<keyID>
# AWS_SECRET_ACCESS_KEY=<applicationKey>
# AWS_STORAGE_BUCKET_NAME=threadloom
# AWS_S3_ENDPOINT_URL=https://s3.us-west-002.backblazeb2.com
# AWS_S3_REGION_NAME=us-west-002
# (Cloudflare R2 also works here and supports AWS_S3_REGION_NAME=auto —
# leave AWS_S3_ENDPOINT_URL unset entirely to use real AWS S3 instead,
# where AWS_S3_REGION_NAME then defaults to us-east-1.)

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=True

CORS_ALLOW_ALL=True
# Production (Render): CORS_ALLOW_ALL=False plus your deployed Vercel URL:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
